# Database Configuration
# Имя БД и строка подключения к PostgreSQL (например, локальная или облачная БД)
DATABASE_URL="postgresql://username:password@localhost:5432/techgear?schema=public"

# NextAuth Configuration
# Секретный ключ для шифрования токенов сессий Auth.js (сгенерируйте с помощью: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret-key-at-least-32-chars"
# Базовый URL-адрес приложения (для локальной разработки: http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# Telegram Bot API Configuration
# Токен бота Telegram (получите у @BotFather)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# Идентификатор чата/группы администраторов для отправки уведомлений
TELEGRAM_CHAT_ID="-100123456789"

# Cloudinary Configuration (Хранение изображений)
# Секретный URL-адрес подключения Cloudinary
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
# API-ключ Cloudinary
CLOUDINARY_API_KEY="your-cloudinary-api-key"
# Секретный ключ API Cloudinary
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Email Configuration (SMTP для восстановления паролей)
# Логин для SMTP-сервера
SMTP_USER="user@example.com"
# Пароль для SMTP-сервера
SMTP_PASS="your-smtp-password"
# Хост SMTP-сервера (например, smtp.mailtrap.io или smtp.yandex.ru)
SMTP_HOST="smtp.example.com"
# Порт SMTP-сервера (например, 587 или 465)
SMTP_PORT="587"
