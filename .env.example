# Environment variables for TechGear
# Copy this file to .env and replace placeholders with your actual database credentials

DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# Auth.js (NextAuth)
AUTH_SECRET="your-32-character-secret-key"
NEXTAUTH_SECRET="your-32-character-secret-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP Configuration (Password Reset & Notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="TechGear <noreply@techgear.uz>"

# Telegram Bot (Admin Order Alerts)
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# Backblaze B2 Object Storage (S3-compatible image upload)
B2_KEY_ID="your-b2-key-id"
B2_APPLICATION_KEY="your-b2-application-key"
B2_BUCKET_NAME="techgear-products"
B2_ENDPOINT="https://s3.eu-central-003.backblazeb2.com"
B2_REGION="eu-central-003"

# Cron API Security (Exchange Rate Sync)
CRON_SECRET="your-cron-secret-key"
